{
  "expo": {
    "name": "Rockland",
    "slug": "Rockland",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rockland_logo.png",
    "scheme": "rockland",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby rocks on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rockland_adaptive_logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBfYOI8RE7RbJ-63czEd7dI2kM92dflIa8"
        }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.rockland.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rockland_adaptive_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea8228ee-a6c9-4334-b6ae-f0dcae977778"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ea8228ee-a6c9-4334-b6ae-f0dcae977778",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0"
  }
}
