    "dev": "start cmd /k \"npm run setup-backend\" && npm run start"
  },
  "dependencies": {
    "all": "^0.0.0",
    "expo": "^53.0.20",
    "lucide-react": "^0.525.0",
    "@react-native-picker/picker": "2.11.1"
  },
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
